{
    "active_data_source": "tcp",
    "active_parser": "tlm",
    "data_sources": {
        "tcp": {
            "host": "localhost",
            "port": 8082,
            "autoReconnect": true,
            "reconnectInterval": 5000,
            "statsEnabled": false,
            "statsInterval": 10000
        },
        "serial": {
            "port": "/dev/cu.usbserial-0001",
            "baudRate": 115200,
            "dataBits": 8,
            "parity": "none",
            "stopBits": 1,
            "autoReconnect": true,
            "reconnectInterval": 5000,
            "statsEnabled": false,
            "statsInterval": 10000
        }
    },
    "parsers": {
        "protobuf": {
            "definition": "./proto/payload.proto",
            "cobs_length": 2048
        },
        "json": {},
        "tlm": {
            "validate_parity": true,
            "statsEnabled": true,
            "statsInterval": 10000,
            "supported_message_types": {
                "0x51": "TEC",
                "0x52": "POWER",
                "0x53": "SYSTEM",
                "0x54": "EXP1",
                "0x55": "EXP2",
                "0x56": "EXPIMU"
            }
        }
    },
    "logging": {
        "enabled": true,
        "logLevel": "info",
        "logToFile": true,
        "logToConsole": true
    },
    "local_server": {
        "port": 8083
    },
    "public_server": {
        "port": 8080
    },
    "tcp_api": {
        "port": "80",
        "protocol": "https",
        "host": "dinolabs.eu",
        "endpoint_url": "api/v1/buffer"
    }
}
