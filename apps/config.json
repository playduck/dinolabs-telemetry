{
    "active_data_source": "dummy",
    "active_parser": "json",

    "data_sources": {
        "tcp": {
            "host": "localhost",
            "port": 8081
        },
        "opcua": {
            "endpoint_url": "opc.tcp://0.0.0.0:4840/warr/telemetry/server/",
            "namespace_uri": "http://rocketry.warr.com/opcua/server",
            "requestedInterval": 25,
            "browsePathTemplate": "/Objects/{namespaceIndex}:payload/{namespaceIndex}:dinolabs.{namespaceIndex}:data"
        },
        "dummy": {
            "interval": 200,
            "jitter": 0.1
        }
    },

    "parsers": {
        "protobuf": {
            "definition": "./proto/payload.proto",
            "cobs_length": 2048
        },
        "json": {}
    },

    "local_server": {
        "port": 8083
    },
    "public_server": {
        "port": 8080
    },
    "tcp_api": {
        "port": "80",
        "protocol": "https",
        "host": "dinolabs.eu",
        "endpoint_url": "api/v1/buffer"
    }
}
